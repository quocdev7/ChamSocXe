# Backend ChamSocXe — chép thành `.env` rồi điền giá trị.

PORT=3041
NODE_ENV=development
CORS_ORIGIN=http://localhost:5200

# ── Mongo ────────────────────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=cham_soc_xe

# ── Quản trị ─────────────────────────────────────────────────────────────────────────────────
# Khoá ký vé đăng nhập trang quản trị. Đổi thành chuỗi ngẫu nhiên dài khi lên máy chủ thật.
JWT_SECRET=doi-thanh-chuoi-ngau-nhien
JWT_HET_HAN=12h

# Tài khoản quản trị đầu tiên — CHỈ dùng khi DB chưa có quản trị viên nào (lần chạy đầu).
# Đăng nhập xong nên đổi mật khẩu ở trang quản trị.
ADMIN_TAI_KHOAN=admin
ADMIN_MAT_KHAU=admin@123

# ── Đặt lịch ─────────────────────────────────────────────────────────────────────────────────
# Số xe tối đa nhận cùng một khung giờ tại cửa hàng.
SUC_CHUA_MOI_KHUNG=3

RATE_LIMIT_GLOBAL_MAX=2000
# Số lần gửi form đặt lịch / liên hệ tối đa mỗi IP trong 15 phút.
RATE_LIMIT_FORM_MAX=20
