    "seed:lai": "node scripts/khoi-tao-du-lieu.mjs --xoa",
    "test": "node scripts/test-api.mjs"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.1",
    "express-rate-limit": "7.5.1",
    "jsonwebtoken": "9.0.3",
    "mongodb": "6.21.0"
  }
}
