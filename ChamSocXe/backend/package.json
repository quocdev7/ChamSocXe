{
  "name": "cham-soc-xe-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend website rửa xe & chăm sóc xe ô tô — dịch vụ, chi nhánh, đặt lịch, tin tức (MongoDB)",
  "engines": {
    "node": ">=18.11"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
